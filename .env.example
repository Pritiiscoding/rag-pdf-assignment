# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any free model slug from https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Qdrant ---
# For local docker: http://localhost:6333
# For Qdrant Cloud free tier: https://xxxxx.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_docs

# --- Embeddings ---
# Local, free, no API key needed (runs via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking / Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- Data ---
PDF_DIR=data/pdfs
