# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any free model slug from https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Qdrant ---
# For local docker: http://localhost:6333
# For Qdrant Cloud free tier: https://xxxxx.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_docs

# --- Embeddings ---
# Local, free, no API key needed (runs via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to true to use OpenAI API embeddings (saves storage on cloud platforms)
# RECOMMENDED for local testing if you have torch/DLL issues
USE_API_EMBEDDINGS=true
# Required if USE_API_EMBEDDINGS=true
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Chunking / Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- Data ---
PDF_DIR=data/pdfs

# --- Storage Management ---
# Automatically clean up old PDF files
AUTO_CLEANUP_FILES=true
# Maximum age of files before cleanup (in hours)
MAX_FILE_AGE_HOURS=24
